{
  "schema_version": 1,
  "api_contracts": [],
  "data_contracts": [
    {
      "name": "Finding V2",
      "source_of_truth": "internal/model/model.go::Finding",
      "mutability": "runtime output",
      "legal_writes": [
        "registered detector analyzers"
      ],
      "retention": "caller-defined",
      "invariants": [
        "category is one of five DoctorCode domains",
        "confidence is explicit",
        "safe_autofix is false for M01"
      ]
    },
    {
      "name": "AuditResult V1",
      "source_of_truth": "internal/model/model.go::AuditResult",
      "mutability": "runtime output",
      "legal_writes": [
        "detector engine"
      ],
      "retention": "caller-defined",
      "invariants": [
        "analyzers are named",
        "findings are stably sorted"
      ]
    },
    {
      "name": "EvidencePacket V1",
      "source_of_truth": "internal/evidence/packet.go::Packet",
      "mutability": "runtime output",
      "legal_writes": [
        "evidence reducer"
      ],
      "retention": "caller-defined",
      "invariants": [
        "serialized packet fits max-bytes",
        "security findings omit source excerpts by default"
      ]
    },
    {
      "name": "ScanResult V1",
      "source_of_truth": "internal/model/model.go::ScanResult",
      "mutability": "runtime output",
      "legal_writes": [
        "doctorcode scan"
      ],
      "retention": "caller-defined",
      "invariants": [
        "language recognition is structural only"
      ]
    },
    {
      "name": "ToolchainStatus V1",
      "source_of_truth": "internal/model/model.go::ToolchainStatus",
      "mutability": "runtime output",
      "legal_writes": [
        "doctorcode toolchains"
      ],
      "retention": "caller-defined",
      "invariants": [
        "missing optional toolchains are reported as unavailable"
      ]
    },
    {
      "name": "BenchmarkManifest V1",
      "source_of_truth": "internal/benchmark/benchmark.go::Manifest",
      "mutability": "tracked test input",
      "legal_writes": [
        "maintainer-reviewed benchmark corpus changes"
      ],
      "retention": "version controlled",
      "invariants": [
        "schema_version is 1",
        "case roots are relative and resolve inside the manifest directory",
        "precision and recall thresholds are within 0..1",
        "expected findings identify rule and path"
      ]
    },
    {
      "name": "BenchmarkReport V1",
      "source_of_truth": "internal/benchmark/benchmark.go::Report",
      "mutability": "runtime output",
      "legal_writes": [
        "doctorcode benchmark"
      ],
      "retention": "CI log or caller-defined",
      "invariants": [
        "unmatched expected labels count as false negatives",
        "unmatched actual findings count as false positives",
        "passed is false when a mismatch or threshold failure exists",
        "metrics describe only the supplied manifest corpus"
      ]
    }
  ],
  "ui_surfaces": [],
  "runbook_steps": [
    {
      "name": "Unit and corpus tests",
      "command": "go test ./...",
      "expected": "exit code 0"
    },
    {
      "name": "Precision benchmark gate",
      "command": "go run ./cmd/doctorcode benchmark internal/benchmark/testdata/manifest.json --json",
      "expected": "passed=true; current nine-case corpus reports 5 TP, 0 FP, 0 FN"
    },
    {
      "name": "Static vet",
      "command": "go vet ./...",
      "expected": "exit code 0"
    },
    {
      "name": "Build CLI",
      "command": "go build -trimpath ./cmd/doctorcode",
      "expected": "exit code 0"
    },
    {
      "name": "Audit smoke",
      "command": "go run ./cmd/doctorcode audit . --json --max-findings=10",
      "expected": "valid JSON and exit code 0"
    },
    {
      "name": "Bounded packet smoke",
      "command": "go run ./cmd/doctorcode next . --json --max-bytes=4096",
      "expected": "valid bounded JSON or NO_FINDINGS"
    }
  ]
}
